# Copy to .env and adjust. All settings: backend/kerstin/config.py

# Server (default: plain HTTP on localhost; for HTTPS on the LAN see below)
KERSTIN_HOST=127.0.0.1
KERSTIN_PORT=8770

# HTTPS on the LAN (make certs). Without these, Kerstin serves plain HTTP on 127.0.0.1.
# 0.0.0.0 makes Kerstin reachable from the LAN (and NordVPN Meshnet peers) with NO auth;
# use it only on a trusted home network (D010).
# KERSTIN_HOST=0.0.0.0
# KERSTIN_TLS_CERTFILE=certs/kerstin.crt
# KERSTIN_TLS_KEYFILE=certs/kerstin.key
# KERSTIN_TLS_CA_CERTFILE=certs/kerstin-ca.crt

# Thermal guard (D016): refuse new GPU work above hot, resume below resume
# KERSTIN_THERMAL_GUARD=true
# KERSTIN_THERMAL_HOT_C=80.0
# KERSTIN_THERMAL_RESUME_C=74.0

# LLM via Ollama
KERSTIN_OLLAMA_URL=http://127.0.0.1:11434
KERSTIN_OLLAMA_MODEL=gemma4:26b
# Unload the model after idle so the shared GPU is freed for other projects
KERSTIN_OLLAMA_KEEP_ALIVE=10m
KERSTIN_LLM_THINK=false
KERSTIN_LLM_MAX_REPLY_TOKENS=220
# Preload the model while the opener is spoken, so the first learner turn is warm
# KERSTIN_LLM_WARMUP=true
# Fixed seed for reproducible benches only; unset = a fresh random seed per request
# KERSTIN_LLM_SEED=

# Speech-to-text: "whispercpp" (existing whisper.cpp server), "http" (OpenAI-compatible
# /v1/audio/transcriptions server) or "local" (faster-whisper in-process)
KERSTIN_STT_BACKEND=whispercpp
KERSTIN_STT_URL=http://127.0.0.1:8768
KERSTIN_STT_MODEL=Systran/faster-whisper-large-v3
KERSTIN_STT_LANGUAGE=de
# Drop utterances quieter than this RMS level (dBFS); tune against the UI "Pegel" line
# KERSTIN_STT_MIN_RMS_DBFS=-55.0
# Clean Whisper hallucination/tag output and trim repetition loops
# KERSTIN_STT_FILTER=true

# Text-to-speech: "piper" (local voice file), "http" (OpenAI-compatible /v1/audio/speech), "none" (text only)
KERSTIN_TTS_BACKEND=piper
KERSTIN_PIPER_VOICE_PATH=voices/de_DE-thorsten-medium.onnx
KERSTIN_PIPER_LENGTH_SCALE=1.05
# Speak the first clause early once it has this many words at a comma/colon/dash (0 = off)
# KERSTIN_TTS_FIRST_CLAUSE_MIN_WORDS=4
# KERSTIN_TTS_URL=http://127.0.0.1:8880
# KERSTIN_TTS_MODEL=kokoro
# KERSTIN_TTS_VOICE=martin
