# Copy to .env and adjust. All settings: backend/kerstin/config.py

# Server (keep 127.0.0.1; reach it from the Mac with an SSH tunnel, see README)
KERSTIN_HOST=127.0.0.1
KERSTIN_PORT=8770

# LLM via Ollama
KERSTIN_OLLAMA_URL=http://127.0.0.1:11434
KERSTIN_OLLAMA_MODEL=qwen3:30b-a3b
# Unload the model after idle so the shared GPU is freed for other projects
KERSTIN_OLLAMA_KEEP_ALIVE=10m
KERSTIN_LLM_THINK=false
KERSTIN_LLM_MAX_REPLY_TOKENS=220

# Speech-to-text: "whispercpp" (existing whisper.cpp server), "http" (OpenAI-compatible
# /v1/audio/transcriptions server) or "local" (faster-whisper in-process)
KERSTIN_STT_BACKEND=whispercpp
KERSTIN_STT_URL=http://127.0.0.1:8768
KERSTIN_STT_MODEL=Systran/faster-whisper-large-v3
KERSTIN_STT_LANGUAGE=de

# Text-to-speech: "piper" (local voice file), "http" (OpenAI-compatible /v1/audio/speech), "none" (text only)
KERSTIN_TTS_BACKEND=piper
KERSTIN_PIPER_VOICE_PATH=voices/de_DE-thorsten-high.onnx
KERSTIN_PIPER_LENGTH_SCALE=1.05
# KERSTIN_TTS_URL=http://127.0.0.1:8880
# KERSTIN_TTS_MODEL=kokoro
# KERSTIN_TTS_VOICE=martin
